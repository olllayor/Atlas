import { BrowserWindow, ipcMain } from 'electron/main';
import { IPC_CHANNELS } from '../../shared/ipc';
import { assertTrustedSender } from './security';
export function registerChatIpc(chatEngine) {
    ipcMain.handle(IPC_CHANNELS.chatStart, async (event, request) => {
        assertTrustedSender(event);
        const window = BrowserWindow.fromWebContents(event.sender);
        if (!window) {
            throw new Error('Unable to resolve the source window for this chat request.');
        }
        return chatEngine.start(window, request);
    });
    ipcMain.handle(IPC_CHANNELS.chatAbort, (event, requestId) => {
        assertTrustedSender(event);
        chatEngine.abort(requestId);
    });
}
