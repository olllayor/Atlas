const PROVIDER_LOGO_ALIASES = {
    '01-ai': 'openrouter',
    'azure-openai': 'azure',
    bedrock: 'amazon-bedrock',
    'google-ai-studio': 'google',
    'google-gemini': 'google',
    meta: 'llama',
    'meta-llama': 'llama',
    mistralai: 'mistral',
    moonshot: 'moonshotai',
    'openai-community': 'openai',
    qwen: 'alibaba',
    'x-ai': 'xai',
