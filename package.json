{
  "name": "atlas-chat",
  "version": "0.1.18",
  "private": false,
  "author": "Olloyor",
  "description": "Local-first, privacy-focused BYOK desktop AI workspace and agent studio with multi-provider support, MCP integration, and interactive visual artifacts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olllayor/Atlas.git"
  },
  "bugs": {
    "url": "https://github.com/olllayor/Atlas/issues"
  },
  "homepage": "https://github.com/olllayor/Atlas#readme",
  "keywords": [
    "electron",
    "react",
    "openrouter",
    "byok",
    "desktop",
    "chat"
  ],
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && electron-vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "bench:typing": "node scripts/perf/benchTyping.mjs",
    "bench:eventloop": "ELECTRON_RUN_AS_NODE=1 npx electron --import tsx scripts/perf/eventLoopProbe.mjs",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3,keytar,node-pty",
    "icons:mac": "node generate-icon.cjs",
    "postinstall": "electron-builder install-app-deps",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "package": "pnpm run icons:mac && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --arm64 --publish never",
    "package:signed": "pnpm run icons:mac && CSC_IDENTITY_AUTO_DISCOVERY=false DEBUG=electron-osx-sign*,electron-notarize* electron-builder --mac --x64 --arm64 --publish never -c.mac.sign=./scripts/sign-macos.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.54",
    "@ai-sdk/openai": "^3.0.49",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/hashes": "^2.4.0",
    "@opencode-ai/models": "^0.0.25",
    "@opencode-ai/sdk": "^1.18.23",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.27.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.141",
    "ansi-to-react": "^6.2.6",
    "better-sqlite3": "12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "effect": "^3.22.1",
    "embla-carousel-react": "^8.6.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "keytar": "7.9.0",
    "lucide-react": "1.7.0",
    "media-chrome": "^4.18.3",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "node-pty": "^1.1.0",
    "posthog-js": "^1.364.7",
    "posthog-node": "^5.28.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "shiki": "^4.0.2",
    "slot-text": "0.2.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.0",
    "@electron/rebuild": "4.0.3",
    "@tailwindcss/vite": "4.2.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/dagre": "^0.7.54",
    "@types/jszip": "^3.4.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "^17.4.0",
    "electron": "41.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "5.0.0",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "com.olllayor.atlaschat",
    "productName": "Atlas",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "build/icon.icns",
        "to": "assets/icon.icns"
      },
      {
        "from": "resources/plugins",
        "to": "plugins"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "files": [
        "out/**/*",
        "package.json",
        "!**/node_modules/node-pty/prebuilds/win32-*/**/*",
        "!**/node_modules/node-pty/third_party/conpty/**/*"
      ],
      "sign": "./scripts/sign-macos.mjs",
      "entitlements": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    }
  }
}
