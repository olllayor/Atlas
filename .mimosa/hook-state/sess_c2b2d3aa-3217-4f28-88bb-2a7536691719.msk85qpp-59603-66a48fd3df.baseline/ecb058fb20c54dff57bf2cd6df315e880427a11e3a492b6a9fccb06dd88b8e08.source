export function encodeConversationPageCursor(payload) {
    return encodeURIComponent(JSON.stringify(payload));
}
export function decodeConversationPageCursor(cursor) {
    try {
        const parsed = JSON.parse(decodeURIComponent(cursor));
        if (!parsed?.createdAt || !parsed?.id) {
            return null;
        }
        return parsed;
    }
    catch {
        return null;
    }
}
